{$ASSETGUARD_PUBLIC_HOST} {
    encode zstd gzip
    reverse_proxy api:8000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }
    request_body {
        max_size 3MB
    }
}
