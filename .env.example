# This file intentionally contains no real secrets.
# Create .env with scripts/windows/new-local-env.ps1 before starting the MVP.

# ASSETGUARD_POSTGRES_DB=assetguard
# ASSETGUARD_POSTGRES_USER=assetguard
# ASSETGUARD_POSTGRES_PASSWORD=<long-random-secret>
# ASSETGUARD_POSTGRES_PORT=5433
# ASSETGUARD_DATABASE_URL=postgresql+psycopg://assetguard:<password>@127.0.0.1:5433/assetguard
# ASSETGUARD_INVENTORY_SHARED_SECRET=<long-random-secret>
# ASSETGUARD_ADMIN_SHARED_SECRET=<long-random-secret>
# ASSETGUARD_VIEWER_SHARED_SECRET=<long-random-secret>
# ASSETGUARD_PREVIOUS_INVENTORY_SHARED_SECRET=<only-during-rotation>
# ASSETGUARD_PREVIOUS_ADMIN_SHARED_SECRET=<only-during-rotation>
# ASSETGUARD_MAX_INVENTORY_PAYLOAD_BYTES=2097152
# ASSETGUARD_RATE_LIMIT_PER_MINUTE=120
# ASSETGUARD_ENDPOINT_STALE_AFTER_HOURS=24
# ASSETGUARD_PUBLIC_HOST=assetguard.example.org
# ASSETGUARD_PUBLIC_URL=https://assetguard.example.org
# ASSETGUARD_DEMO_PORT=8000
# ASSETGUARD_VISION_MODEL_ID=IDEA-Research/grounding-dino-tiny
# ASSETGUARD_VISION_CONFIDENCE_THRESHOLD=0.35
# ASSETGUARD_VISION_CLASSES=monitor,computer,printer,projector,television,keyboard,laptop,chair,table
# ASSETGUARD_VISION_MAX_IMAGE_BYTES=10485760
# ASSETGUARD_VISION_STORAGE_ROOT=.local/vision
# Telegram notifications are optional. Keep the bot token only in .env, never in Git.
# ASSETGUARD_TELEGRAM_BOT_TOKEN=<token-issued-by-BotFather>
# ASSETGUARD_TELEGRAM_CHAT_ID=<numeric-private-or-group-chat-id>
